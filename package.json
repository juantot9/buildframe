{
  "name": "buildframe-workspace",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@11.10.0",
  "engines": {
    "node": ">=26.4.0 <27.0.0"
  },
  "type": "module",
  "scripts": {
    "check:node": "node scripts/check-node-version.mjs",
    "prepare": "git config core.hooksPath .githooks",
    "check:file-size": "node scripts/check-staged-file-size.mjs",
    "test:fast": "pnpm check:node && NODE_OPTIONS=--experimental-ffi vitest run --config vitest.config.ts packages/workspace/test/fast packages/local-runtime/test/fast packages/pi-adapter/test/fast packages/claude-adapter/test/fast apps/buildframe/test/fast",
    "test": "pnpm check:node && NODE_OPTIONS=--experimental-ffi vitest run --config vitest.config.ts",
    "typecheck": "pnpm --filter @buildframe/workspace --filter @buildframe/local-runtime --filter @buildframe/pi-adapter-source --filter @buildframe/claude-adapter-source --filter @buildframe/opencode-adapter-source --filter @buildframe/codex-adapter-source --filter @buildframe/app-source -r typecheck && tsc --noEmit -p tsconfig.tests.json",
    "clean": "pnpm -r --if-present run clean",
    "build": "pnpm --filter @buildframe/workspace --filter @buildframe/local-runtime --filter @buildframe/pi-adapter-source --filter @buildframe/claude-adapter-source --filter @buildframe/opencode-adapter-source --filter @buildframe/codex-adapter-source --filter @buildframe/app-source -r build",
    "smoke:build": "node scripts/smoke-build.mjs && node --experimental-ffi scripts/smoke-claude-direct.mjs",
    "risk:state": "pnpm --filter @buildframe/workspace build && node scripts/probe-authoritative-state.mjs",
    "risk:runtime": "pnpm --filter @buildframe/workspace --filter @buildframe/local-runtime --filter @buildframe/app-source -r build && node scripts/probe-local-runtime.mjs",
    "risk:pi": "pnpm --filter @buildframe/workspace --filter @buildframe/local-runtime --filter @buildframe/pi-adapter-source -r build && node scripts/probe-pi-adapter.mjs",
    "risk:dogfood": "pnpm check:node && pnpm --filter @buildframe/workspace --filter @buildframe/local-runtime --filter @buildframe/pi-adapter-source --filter @buildframe/app-source -r build && node --experimental-ffi scripts/probe-dogfood.mjs",
    "dogfood": "pnpm check:node && pnpm build && pnpm --filter @buildframe/app-source dogfood",
    "fixture:state": "node scripts/generate-authoritative-state-golden.mjs",
    "fixture:state:format-2": "pnpm build && node --experimental-ffi scripts/generate-authoritative-state-format-2.mjs",
    "lint": "oxlint",
    "format:check": "oxfmt --check .",
    "format": "oxfmt .",
    "check:dependencies": "node scripts/check-dependencies.mjs",
    "verify": "pnpm lint && pnpm format:check && pnpm check:dependencies && pnpm test && pnpm typecheck && pnpm build && pnpm smoke:build",
    "release:assemble": "pnpm build && node scripts/assemble-release.mjs",
    "release:manifest": "pnpm --filter @buildframe/workspace --filter @buildframe/local-runtime --filter @buildframe/app-source -r build && node scripts/assemble-release.mjs --manifest-only"
  },
  "devDependencies": {
    "@opentui/core": "0.9.7",
    "@types/node": "^26.6.6",
    "esbuild": "0.28.2",
    "oxfmt": "0.79.0",
    "oxlint": "1.94.0",
    "tsx": "^4.23.15",
    "typescript": "^5.7.2",
    "vitest": "^4.1.12"
  },
  "license": "MIT"
}
