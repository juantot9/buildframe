{
  "name": "@buildframe/local-runtime",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=26.4.0 <27.0.0"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "development": {
        "types": "./src/index.ts",
        "import": "./src/index.ts"
      },
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./launcher": {
      "development": {
        "types": "./src/launcher.ts",
        "import": "./src/launcher.ts"
      },
      "types": "./dist/launcher.d.ts",
      "import": "./dist/launcher.js"
    },
    "./harness-adapter": {
      "development": {
        "types": "./src/harnessAdapter.ts",
        "import": "./src/harnessAdapter.ts"
      },
      "types": "./dist/harnessAdapter.d.ts",
      "import": "./dist/harnessAdapter.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "clean": "rm -rf dist",
    "build": "pnpm run clean && tsc -p tsconfig.json"
  },
  "dependencies": {
    "@buildframe/workspace": "workspace:*"
  }
}
