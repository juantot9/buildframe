{
  "name": "@buildframe/opencode-adapter-source",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=26.4.0 <27.0.0"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "development": {
        "types": "./src/index.ts",
        "import": "./src/index.ts"
      },
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./tui": {
      "development": {
        "types": "./src/tui.ts",
        "import": "./src/tui.ts"
      },
      "types": "./dist/tui.d.ts",
      "import": "./dist/tui.js"
    }
  },
  "files": [
    "dist"
  ],
  "buildframe": {
    "supportedOpenCodeVersions": [
      ">=2.3.2 <3.0.0"
    ],
    "verifiedOpenCodeVersions": [
      "2.3.2"
    ],
    "adapterProtocolVersions": [
      1
    ]
  },
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "clean": "rm -rf dist",
    "build": "pnpm run clean && tsc -p tsconfig.json"
  },
  "dependencies": {
    "@buildframe/local-runtime": "workspace:*",
    "@buildframe/workspace": "workspace:*"
  }
}
