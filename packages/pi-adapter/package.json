{
  "name": "@buildframe/pi-adapter-source",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=26.4.0 <27.0.0"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "development": {
        "types": "./src/index.ts",
        "import": "./src/index.ts"
      },
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "pi": {
    "extensions": [
      "./dist/index.js"
    ]
  },
  "buildframe": {
    "supportedPiVersions": [
      ">=0.80.6 <2.0.0"
    ],
    "verifiedPiVersions": [
      "0.80.6",
      "0.80.7",
      "0.80.10",
      "0.81.0",
      "0.81.1",
      "0.82.1",
      "0.84.1",
      "0.85.1",
      "1.3.0"
    ],
    "adapterProtocolVersions": [
      1
    ]
  },
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "clean": "node ../../scripts/remove-dist.mjs",
    "build": "pnpm run clean && tsc -p tsconfig.json"
  },
  "dependencies": {
    "@buildframe/local-runtime": "workspace:*",
    "@buildframe/workspace": "workspace:*"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "1.6.0"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": ">=0.80.6 <2.0.0"
  }
}
