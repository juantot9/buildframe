{
  "name": "@buildframe/codex-adapter-source",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=26.4.0 <27.0.0"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "development": {
        "types": "./src/index.ts",
        "import": "./src/index.ts"
      },
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./helper": {
      "development": {
        "types": "./src/helper.ts",
        "import": "./src/helper.ts"
      },
      "types": "./dist/helper.d.ts",
      "import": "./dist/helper.js"
    }
  },
  "files": [
    "dist"
  ],
  "buildframe": {
    "supportedCodexVersions": [
      ">=0.170.0 <1.0.0"
    ],
    "verifiedCodexVersions": [
      "0.170.0",
      "0.171.0"
    ],
    "adapterProtocolVersions": [
      1
    ]
  },
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "clean": "rm -rf dist",
    "build": "pnpm run clean && tsc -p tsconfig.json"
  },
  "dependencies": {
    "@buildframe/local-runtime": "workspace:*",
    "@buildframe/workspace": "workspace:*"
  }
}
