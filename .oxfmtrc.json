{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "printWidth": 120,
  "singleQuote": true,
  "arrowParens": "avoid",
  "trailingComma": "all",
  "semi": true,
  "sortImports": false,
  "sortPackageJson": false,
  "sortTailwindcss": false,
  "ignorePatterns": [
    "**/dist/**",
    "**/node_modules/**",
    "**/test/fixtures/**",
    "**/*.md",
    ".neoflow/**",
    "pnpm-*.yaml",
    ".pi/**",
    ".claude/**"
  ]
}
